# Copy to .env (never commit .env). See SETUP.md.

# Supabase — filled in automatically once the project is created
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=

# Razorpay (test mode). Key ID is public; the secret stays server-side.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend (optional until you want emails sent)
RESEND_API_KEY=
EMAIL_FROM=
STORE_INBOX_EMAIL=

# Public site URL (used for auth redirects, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
